# Groq API key. If left blank, ai_service.py automatically falls back to a
# mock AI response so the whole project still runs end to end without a key.
GROQ_API_KEY=

# Model used for AI lead briefs.
GROQ_MODEL=llama-3.1-8b-instant

# SQLite database file location (relative to backend/).
DATABASE_URL=sqlite:///./leadflow.db
